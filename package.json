{
  "name": "cb-skie",
  "private": true,
  "version": "1.0.0",
  "description": "Chatbot AI esports dengan RAG (React Vite + Tailwind, Express, MySQL)",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w server",
    "ingest": "npm run ingest -w server",
    "test": "npm test -w server",
    "lint": "npm run lint -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
