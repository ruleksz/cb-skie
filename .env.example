# Salin berkas ini menjadi .env di root repo, lalu isi nilainya.

# --- Server ---
PORT=3001
# Asal frontend yang diizinkan (CORS). Pisahkan dengan koma jika lebih dari satu.
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL (nilai bawaan cocok dengan docker-compose.yml) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=esports
DB_PASSWORD=esports
DB_NAME=esports_chatbot

# --- LLM (API yang kompatibel dengan OpenAI Chat Completions) ---
# Pilihan: gemini | openai | groq | custom
LLM_PROVIDER=gemini
LLM_API_KEY=
# Kosongkan untuk memakai model bawaan penyedia (hanya gemini yang punya bawaan).
# Untuk openai / groq / custom, isi dengan nama model dari dokumentasi penyedia.
LLM_MODEL=
# Hanya untuk LLM_PROVIDER=custom, mis. http://localhost:11434/v1
LLM_BASE_URL=

# --- Embedding ---
# local = model berjalan di server (tanpa API key, diunduh sekali saat pertama dipakai)
# api   = endpoint /embeddings yang kompatibel dengan OpenAI
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Hanya untuk EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- RAG ---
# Jumlah potongan teks yang dikirim ke LLM.
RAG_TOP_K=5
# Kemiripan kosinus minimum (0-1). Di bawah nilai ini potongan dianggap tidak relevan.
# 0.81 dikalibrasi untuk multilingual-e5-small; model embedding lain perlu nilai berbeda.
RAG_MIN_SCORE=0.81
